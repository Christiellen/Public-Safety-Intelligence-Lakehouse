# Copy to n8n.env (ignored by Git) and fill in. Secrets (tokens, API keys, SMTP password) do NOT go
# here: they are n8n credentials, stored encrypted in the n8n database.
DATABRICKS_HOST=https://<your-workspace>.cloud.databricks.com
PSI_JOB_ID=<id of the job "PSI - Lakehouse, spatial analytics and graph">
DATABRICKS_WAREHOUSE_ID=<SQL warehouse id>
BRIEFING_EMAIL_TO=<recipient e-mail>
BRIEFING_EMAIL_FROM=<sender e-mail, the SMTP account>
GEMINI_MODEL=gemini-3.6-flash
BRIEFING_LANGUAGE=English

# n8n
GENERIC_TIMEZONE=America/Sao_Paulo
TZ=America/Sao_Paulo
N8N_BLOCK_ENV_ACCESS_IN_NODE=false
