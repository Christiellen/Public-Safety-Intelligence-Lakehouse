# Copy to .env (ignored by Git) and change every value. Use letters and digits in the passwords:
# they go into connection URLs.

# PostgreSQL superuser: owns the databases superset and psi, used by the loader
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me

# Read-only role Superset uses to query the BI views (schema psi_bi only)
PSI_READER_USER=psi_reader
PSI_READER_PASSWORD=change-me-too

# Superset: generate the key with  openssl rand -base64 42
SUPERSET_SECRET_KEY=
SUPERSET_ADMIN_USER=admin
SUPERSET_ADMIN_PASSWORD=change-me-as-well
SUPERSET_PORT=8088

# Optional: Mapbox token for deck.gl maps of the municipality centroids
MAPBOX_API_KEY=
